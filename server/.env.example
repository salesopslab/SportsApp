# The Odds API — https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE=https://api.the-odds-api.com/v4

# SportsDataIO — https://sportsdata.io (stats, H2H history, injuries)
SPORTSDATA_API_KEY=your_sportsdata_api_key_here
SPORTSDATA_NFL_BASE=https://api.sportsdata.io/v3/nfl
SPORTSDATA_NBA_BASE=https://api.sportsdata.io/v3/nba
SPORTSDATA_MLB_BASE=https://api.sportsdata.io/v3/mlb
SPORTSDATA_CFB_BASE=https://api.sportsdata.io/v3/cfb
SPORTSDATA_CBB_BASE=https://api.sportsdata.io/v3/cbb

# OpenWeatherMap — https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_key_here
WEATHER_API_BASE=https://api.openweathermap.org/data/2.5

# Anthropic — https://console.anthropic.com (grounds the AI chat in the data above)
ANTHROPIC_API_KEY=your_anthropic_key_here

PORT=8080
CACHE_TTL_SECONDS=90

# ---- Live data + AI chat freshness (all optional; defaults shown) ----
# Chat model and Anthropic server-side web search (uses ANTHROPIC_API_KEY;
# web search must be enabled for your org in the Claude Console).
CHAT_MODEL=claude-sonnet-5
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TOOL_TYPE=web_search_20250305
WEB_SEARCH_MAX_USES=4
# Injury reports: cache lifetime, and max age before the chat must refresh.
INJURY_CACHE_TTL_SECONDS=600
INJURY_FRESHNESS_MINUTES=15
# Odds: max age before the chat refreshes; min age before a refresh may spend a credit.
ODDS_FRESHNESS_MINUTES=15
ODDS_MIN_REFRESH_AGE_SECONDS=300
